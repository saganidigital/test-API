# ==============================================================================
# Nexus Software Store - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH PRODUCTION CREDENTIALS
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# JSON Web Token Secret (Generate a high-entropy string: openssl rand -hex 32)
JWT_SECRET=replace_with_a_cryptographically_secure_jwt_secret_key_32chars

# Database Connection (Microsoft SQL Server / Azure SQL)
# Required for live database mode. Leave empty or unset to use serverless cloud mock mode.
DB_CONNECTION_STRING=Server=your-sql-server.database.windows.net,1433;Database=SoftwareCommerceDB;User Id=cloud_admin;Password=YourSecurePassword123!;Encrypt=true;TrustServerCertificate=false;

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=https://test-api.vercel.app,http://localhost:5000

# Frontend Custom Backend API URL Override (Optional)
# If left unset, frontend automatically routes to the same-origin /api endpoints on Vercel
NEXUS_API_URL=
